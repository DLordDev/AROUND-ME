rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUser(data, userId) {
      return data.uid == userId &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('payoutDetails' in data) || (data.payoutDetails is map));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId) &&
                       request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Favorites
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId) &&
                         request.resource.data.userId == userId &&
                         request.resource.data.placeId is string &&
                         request.resource.data.name is string && request.resource.data.name.size() <= 200;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId);
      }

      // Subcollection: Search History
      match /search_history/{historyId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(historyId) &&
                         request.resource.data.userId == userId &&
                         request.resource.data.query is string && request.resource.data.query.size() <= 500;
        allow update: if false; // Search history is append-only
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      // Subcollection: Preferences
      match /preferences/{prefId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(prefId) &&
                                 request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(prefId);
      }
    }

    // Community Restaurant Reviews
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(reviewId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.placeId is string &&
                       request.resource.data.placeId.size() <= 200 &&
                       request.resource.data.userName is string &&
                       request.resource.data.userName.size() <= 100 &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string &&
                       request.resource.data.comment.size() <= 1000;
      allow update: if isSignedIn() && isValidId(reviewId) &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(reviewId) &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
